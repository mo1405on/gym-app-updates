# أرقام الأدمن بصيغة دولية بدون + أو أصفار، مفصولة بفاصلة
# مثال: 966554244571,966500000000
ADMIN_NUMBERS=

# (اختياري) السماح بالعمل داخل مجموعة واتساب معينة أيضًا — اتركه فارغًا لتجاهل المجموعات
ALLOWED_GROUP_JID=

# مسار ملف قاعدة البيانات
DB_PATH=./data/accounting.db

# مسار حفظ جلسة واتساب
AUTH_DIR=./data/auth

# رمز العملة المستخدم في الرسائل
CURRENCY=ر.س

# مستوى تسجيل مكتبة Baileys: silent | error | warn | info | debug
LOG_LEVEL=silent
