# أرقام واتساب المصرح لها بالتعامل مع البوت (فاصلة بينها)، بصيغة دولية بدون + أو رموز
# مثال: 966554244571,966500000000
OWNER_NUMBERS=966554244571
ACCOUNTANT_NUMBERS=

# عملة العرض في الرسائل والتقارير
CURRENCY=ريال

# اسم المنشأة يظهر في رأس التقارير
BUSINESS_NAME=الرواد ستور

# سقف المبلغ الذي يتطلب تأكيد قبل الترحيل (اتركه فارغاً لتعطيل التأكيد)
CONFIRM_ABOVE_AMOUNT=5000

# مسار قاعدة البيانات
DB_PATH=./data/accounting.db

# مسار حفظ جلسة واتساب (بيانات الاقتران)
AUTH_DIR=./data/auth
